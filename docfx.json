{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "my-template"
    ],
    "globalMetadata": {
      "_appName": "Emma's Docs",
      "_appTitle": "emmavdc-documentation",
      "_appFooter": "© 2025 Emma Vandecasteele",
      "_appLogoPath": "images/favicon.ico",
      "_appFaviconPath": "images/favicon.ico",
      "_disableContribution": true,
      "_enableSearch": true,
      "pdf": false
    }
  }
}